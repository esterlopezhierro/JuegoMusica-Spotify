<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-950 text-slate-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Spotify Random Secret Song</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }
        
        /* Blur reveal effect */
        .blur-hidden {
            filter: blur(20px);
            opacity: 0.2;
            transform: scale(0.95);
            pointer-events: none;
            transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
        
        .blur-visible {
            filter: blur(0);
            opacity: 1;
            transform: scale(1);
            transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* Pulse animation for equalizer */
        @keyframes sound-wave {
            0%, 100% { height: 6px; }
            50% { height: 28px; }
        }
        
        .bar {
            width: 4px;
            background-color: #1DB954;
            border-radius: 2px;
            animation: sound-wave 1.2s ease-in-out infinite;
        }
        .bar:nth-child(1) { animation-delay: 0.1s; }
        .bar:nth-child(2) { animation-delay: 0.4s; }
        .bar:nth-child(3) { animation-delay: 0.2s; }
        .bar:nth-child(4) { animation-delay: 0.5s; }
        .bar:nth-child(5) { animation-delay: 0.3s; }
    </style>
</head>
<body class="h-full flex justify-center items-center p-2 sm:p-4 bg-slate-950 select-none overflow-hidden">

    <!-- Mobile Frame Outer Container -->
    <div class="relative w-full max-w-md h-[92vh] max-h-[850px] bg-slate-900 border border-slate-800 rounded-[40px] shadow-2xl flex flex-col justify-between overflow-hidden">
        
        <!-- Top Status Bar & Config Button -->
        <header class="p-5 flex justify-between items-center z-20">
            <div class="flex items-center gap-2">
                <i class="fa-brands fa-spotify text-emerald-500 text-2xl"></i>
                <span class="text-xs font-bold tracking-wider text-slate-400 uppercase">Secret Player</span>
            </div>
            
            <button id="configBtn" onclick="toggleConfigModal()" class="w-10 h-10 rounded-full bg-slate-800/80 text-slate-300 flex items-center justify-center hover:bg-slate-700 transition active:scale-95">
                <i class="fa-solid fa-gear"></i>
            </button>
        </header>

        <!-- Main Display Screen (Minimalist UI) -->
        <main class="flex-1 flex flex-col items-center justify-center px-6 relative">
            
            <!-- Dynamic Background Glow -->
            <div id="glowBg" class="absolute w-48 h-48 bg-emerald-500/10 rounded-full blur-3xl transition-all duration-700 pointer-events-none"></div>

            <!-- Mystery Artwork / Hidden Card -->
            <div class="relative w-64 h-64 sm:w-72 sm:h-72 mb-8 rounded-3xl bg-slate-800 border border-slate-700/50 shadow-2xl overflow-hidden flex items-center justify-center">
                
                <!-- Secret Image -->
                <img id="albumCover" class="w-full h-full object-cover blur-hidden" src="" alt="Album Cover">
                
                <!-- Mystery Overlay Icon (shown when hidden) -->
                <div id="mysteryOverlay" class="absolute flex flex-col items-center justify-center text-slate-600 transition-opacity duration-300">
                    <i class="fa-solid fa-compact-disc text-7xl animate-spin" style="animation-duration: 12s;"></i>
                    <p class="text-xs font-semibold mt-4 tracking-widest uppercase text-slate-500">¿Qué canción es?</p>
                </div>
            </div>

            <!-- Equalizer Visualizer (Playing state) -->
            <div id="soundBars" class="h-8 flex items-center justify-center gap-1.5 mb-4 opacity-0 transition-opacity duration-300">
                <div class="bar"></div>
                <div class="bar"></div>
                <div class="bar"></div>
                <div class="bar"></div>
                <div class="bar"></div>
            </div>

            <!-- Reveal Info Container -->
            <div id="songInfo" class="text-center w-full min-h-[90px] flex flex-col justify-center blur-hidden transition-all duration-500">
                <h1 id="songTitle" class="text-xl sm:text-2xl font-extrabold text-white truncate px-2">Título de la Canción</h1>
                <p id="artistName" class="text-base font-semibold text-emerald-400 mt-1 truncate">Nombre del Grupo / Artista</p>
                <p id="releaseYear" class="text-xs font-medium text-slate-400 mt-1 tracking-widest uppercase">Año de Lanzamiento</p>
            </div>
            
        </main>

        <!-- Minimalist Controls Bar -->
        <footer class="p-6 pb-8 flex flex-col items-center gap-4 bg-slate-900/80 backdrop-blur-md border-t border-slate-800/80 z-10">
            
            <!-- Controls Row: Play/Pause & Reveal -->
            <div class="w-full flex items-center justify-around max-w-xs">
                
                <!-- Next Random Song -->
                <button id="nextBtn" onclick="loadNextRandomTrack()" class="w-14 h-14 rounded-full bg-slate-800 text-slate-200 flex items-center justify-center hover:bg-slate-700 transition active:scale-95 shadow-md">
                    <i class="fa-solid fa-shuffle text-lg"></i>
                </button>

                <!-- Main Play / Pause Button -->
                <button id="playBtn" onclick="togglePlay()" class="w-20 h-20 rounded-full bg-emerald-500 text-slate-950 flex items-center justify-center hover:bg-emerald-400 transition transform active:scale-90 shadow-lg shadow-emerald-500/20">
                    <i id="playIcon" class="fa-solid fa-play text-2xl ml-1"></i>
                </button>

                <!-- Reveal Button -->
                <button id="revealBtn" onclick="revealSongDetails()" class="w-14 h-14 rounded-full bg-indigo-600 text-white flex items-center justify-center hover:bg-indigo-500 transition active:scale-95 shadow-md shadow-indigo-600/30">
                    <i id="revealIcon" class="fa-solid fa-eye text-lg"></i>
                </button>

            </div>

            <!-- Minimalist Action Label -->
            <span id="statusLabel" class="text-xs text-slate-500 font-medium">Pulsa ▶ para empezar la música</span>
        </footer>

    </div>

    <!-- Configuration Modal (For Spotify API Key & Mode) -->
    <div id="configModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-slate-900 border border-slate-800 w-full max-w-md rounded-3xl p-6 shadow-2xl relative text-left">
            <button onclick="toggleConfigModal()" class="absolute top-4 right-4 w-8 h-8 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center">
                <i class="fa-solid fa-xmark"></i>
            </button>
            
            <h2 class="text-lg font-bold text-white flex items-center gap-2 mb-2">
                <i class="fa-brands fa-spotify text-emerald-500"></i> Configuración Spotify
            </h2>
            <p class="text-xs text-slate-400 mb-6">
                Puedes conectar tu propio <b>Client ID</b> de Spotify Developer para buscar en todo su catálogo en directo, o usar el modo Demo con canciones variadas sin configuración.
            </p>

            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1 uppercase tracking-wider">Modo de Funcionamiento</label>
                    <select id="modeSelect" onchange="handleModeChange()" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-emerald-500">
                        <option value="demo">Modo Demostración (Sin API Key)</option>
                        <option value="spotify">Spotify API Directo (Requiere Client ID)</option>
                    </select>
                </div>

                <div id="spotifyApiInputs" class="hidden space-y-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1 uppercase tracking-wider">Spotify Client ID</label>
                        <input type="text" id="clientIdInput" placeholder="Introduce tu Client ID" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-emerald-500">
                    </div>
                    <p class="text-[11px] text-slate-500">
                        * Si tienes una Spotify App, añade <code class="bg-slate-800 px-1 py-0.5 rounded text-emerald-400">https://developer.spotify.com</code> o la URL actual a tus Redirect URIs.
                    </p>
                </div>
            </div>

            <div class="mt-6 flex justify-end gap-3">
                <button onclick="saveSettings()" class="w-full bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold py-3 rounded-xl transition">
                    Guardar y Aplicar
                </button>
            </div>
        </div>
    </div>

    <!-- Hidden Audio Tag for Audio Playback -->
    <audio id="audioPlayer" preload="auto"></audio>

    <!-- App Logic -->
    <script>
        // Default Demo Tracks Catalog (Fallback & Instant Play)
        const demoTracks = [
            {
                title: "Bohemian Rhapsody",
                artist: "Queen",
                year: "1975",
                cover: "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?auto=format&fit=crop&w=600&q=80",
                preview: "https://cdns-preview-d.dzcdn.net/stream/c-dd20c4e12c5b36449e759ef177c8e9d3-5.mp3"
            },
            {
                title: "Billie Jean",
                artist: "Michael Jackson",
                year: "1982",
                cover: "https://images.unsplash.com/photo-1514525253161-7a46d19cd819?auto=format&fit=crop&w=600&q=80",
                preview: "https://cdns-preview-7.dzcdn.net/stream/c-7d925e01b1386d34b563a9254d3d27d7-3.mp3"
            },
            {
                title: "Smells Like Teen Spirit",
                artist: "Nirvana",
                year: "1991",
                cover: "https://images.unsplash.com/photo-1498038432885-c6f3f1b912ee?auto=format&fit=crop&w=600&q=80",
                preview: "https://cdns-preview-8.dzcdn.net/stream/c-8a21dd9d762e591ff18d6e3c090680d2-4.mp3"
            },
            {
                title: "Blinding Lights",
                artist: "The Weeknd",
                year: "2020",
                cover: "https://images.unsplash.com/photo-1508700115892-45ecd05ae2ad?auto=format&fit=crop&w=600&q=80",
                preview: "https://cdns-preview-c.dzcdn.net/stream/c-c37357c32bf17c46c3efd3ab33c0dd6e-6.mp3"
            },
            {
                title: "Hotel California",
                artist: "Eagles",
                year: "1976",
                cover: "https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&w=600&q=80",
                preview: "https://cdns-preview-9.dzcdn.net/stream/c-9fef2082b43b6aa38914041b6ec2a3bc-4.mp3"
            }
        ];

        // State Variables
        let currentTrack = null;
        let isPlaying = false;
        let isRevealed = false;
        let appMode = localStorage.getItem('spotify_mode') || 'demo';
        let clientId = localStorage.getItem('spotify_client_id') || '';
        let spotifyAccessToken = null;

        // Elements
        const audioPlayer = document.getElementById('audioPlayer');
        const playBtn = document.getElementById('playBtn');
        const playIcon = document.getElementById('playIcon');
        const revealBtn = document.getElementById('revealBtn');
        const revealIcon = document.getElementById('revealIcon');
        const albumCover = document.getElementById('albumCover');
        const songInfo = document.getElementById('songInfo');
        const songTitle = document.getElementById('songTitle');
        const artistName = document.getElementById('artistName');
        const releaseYear = document.getElementById('releaseYear');
        const mysteryOverlay = document.getElementById('mysteryOverlay');
        const soundBars = document.getElementById('soundBars');
        const statusLabel = document.getElementById('statusLabel');
        const glowBg = document.getElementById('glowBg');

        // Initial setup
        window.onload = () => {
            document.getElementById('modeSelect').value = appMode;
            document.getElementById('clientIdInput').value = clientId;
            handleModeChange();

            // Handle Audio End Event
            audioPlayer.onended = () => {
                setPlayingState(false);
                statusLabel.innerText = "Canción finalizada. Siguiente canción o desvelar.";
            };

            loadNextRandomTrack();
        };

        // Modal Handler
        function toggleConfigModal() {
            const modal = document.getElementById('configModal');
            modal.classList.toggle('hidden');
        }

        function handleModeChange() {
            const selectedMode = document.getElementById('modeSelect').value;
            const apiInputs = document.getElementById('spotifyApiInputs');
            if (selectedMode === 'spotify') {
                apiInputs.classList.remove('hidden');
            } else {
                apiInputs.classList.add('hidden');
            }
        }

        function saveSettings() {
            appMode = document.getElementById('modeSelect').value;
            clientId = document.getElementById('clientIdInput').value.trim();

            localStorage.setItem('spotify_mode', appMode);
            localStorage.setItem('spotify_client_id', clientId);

            toggleConfigModal();
            loadNextRandomTrack();
        }

        // Spotify API Integration (Client Credentials / Search)
        async function fetchSpotifyAccessToken() {
            // Check cache or request new token using Client Credentials
            try {
                // If user hasn't provided a backend, we perform a public search query or fallback
                // Note: Direct client_credentials token requests from client-side CORS require token endpoint
                const response = await fetch('https://accounts.spotify.com/api/token', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: 'grant_type=client_credentials&client_id=' + clientId
                });
                const data = await response.json();
                return data.access_token;
            } catch (err) {
                console.warn("Spotify API error, falling back to Demo Catalog", err);
                return null;
            }
        }

        async function getRandomSpotifyTrack() {
            if (appMode === 'spotify' && clientId) {
                try {
                    const token = await fetchSpotifyAccessToken();
                    if (token) {
                        // Generate random query parameters
                        const characters = 'abcdefghijklmnopqrstuvwxyz';
                        const randomChar = characters.charAt(Math.floor(Math.random() * characters.length));
                        const randomOffset = Math.floor(Math.random() * 50);

                        const res = await fetch(`https://api.spotify.com/v1/search?q=${randomChar}&type=track&limit=10&offset=${randomOffset}`, {
                            headers: { 'Authorization': `Bearer ${token}` }
                        });
                        const data = await res.json();
                        
                        // Find a track with preview_url
                        const tracksWithPreview = data.tracks?.items.filter(t => t.preview_url);
                        if (tracksWithPreview && tracksWithPreview.length > 0) {
                            const selected = tracksWithPreview[Math.floor(Math.random() * tracksWithPreview.length)];
                            return {
                                title: selected.name,
                                artist: selected.artists.map(a => a.name).join(', '),
                                year: selected.album.release_date ? selected.album.release_date.split('-')[0] : 'N/A',
                                cover: selected.album.images[0]?.url || '',
                                preview: selected.preview_url
                            };
                        }
                    }
                } catch (e) {
                    console.error("Spotify Fetch Error:", e);
                }
            }

            // Fallback to offline/demo tracks
            const randomIndex = Math.floor(Math.random() * demoTracks.length);
            return demoTracks[randomIndex];
        }

        // Load & Prepare Next Track
        async function loadNextRandomTrack() {
            // Stop current music
            audioPlayer.pause();
            setPlayingState(false);
            
            // Reset Reveal state
            hideSongDetails();
            statusLabel.innerText = "Cargando canción aleatoria...";

            currentTrack = await getRandomSpotifyTrack();

            if (currentTrack && currentTrack.preview) {
                audioPlayer.src = currentTrack.preview;
                albumCover.src = currentTrack.cover;
                songTitle.innerText = currentTrack.title;
                artistName.innerText = currentTrack.artist;
                releaseYear.innerText = "Año: " + currentTrack.year;
                statusLabel.innerText = "¡Canción lista! Pulsa ▶ para escuchar.";
            } else {
                statusLabel.innerText = "Sin vista previa disponible. Prueba otra.";
            }
        }

        // Play / Pause Logic
        function togglePlay() {
            if (!currentTrack || !currentTrack.preview) {
                loadNextRandomTrack();
                return;
            }

            if (isPlaying) {
                audioPlayer.pause();
                setPlayingState(false);
            } else {
                audioPlayer.play().then(() => {
                    setPlayingState(true);
                }).catch(err => {
                    console.error("Audio play failed:", err);
                    statusLabel.innerText = "Haz clic de nuevo para reproducir audio.";
                });
            }
        }

        function setPlayingState(playing) {
            isPlaying = playing;
            if (playing) {
                playIcon.classList.remove('fa-play');
                playIcon.classList.add('fa-pause');
                soundBars.classList.remove('opacity-0');
                glowBg.classList.add('scale-125', 'bg-emerald-500/20');
                if (!isRevealed) {
                    statusLabel.innerText = "Escuchando... ¿Sabes cuál es?";
                }
            } else {
                playIcon.classList.remove('fa-pause');
                playIcon.classList.add('fa-play');
                soundBars.classList.add('opacity-0');
                glowBg.classList.remove('scale-125', 'bg-emerald-500/20');
            }
        }

        // Reveal Song Info
        function revealSongDetails() {
            if (isRevealed) return;
            isRevealed = true;

            // Animate reveal
            albumCover.classList.remove('blur-hidden');
            albumCover.classList.add('blur-visible');

            songInfo.classList.remove('blur-hidden');
            songInfo.classList.add('blur-visible');

            mysteryOverlay.classList.add('opacity-0');

            revealBtn.classList.remove('bg-indigo-600', 'hover:bg-indigo-500');
            revealBtn.classList.add('bg-slate-700', 'text-slate-400');
            revealIcon.classList.remove('fa-eye');
            revealIcon.classList.add('fa-eye-slash');

            statusLabel.innerText = "¡Desvelado!";
        }

        function hideSongDetails() {
            isRevealed = false;

            albumCover.classList.remove('blur-visible');
            albumCover.classList.add('blur-hidden');

            songInfo.classList.remove('blur-visible');
            songInfo.classList.add('blur-hidden');

            mysteryOverlay.classList.remove('opacity-0');

            revealBtn.classList.remove('bg-slate-700', 'text-slate-400');
            revealBtn.classList.add('bg-indigo-600', 'hover:bg-indigo-500');
            revealIcon.classList.remove('fa-eye-slash');
            revealIcon.classList.add('fa-eye');
        }
    </script>
</body>
</html>